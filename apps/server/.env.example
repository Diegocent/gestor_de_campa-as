# ─────────────────────────────────────────────────────────────
#  Bandeja Compartida / Mini-CRM — Backend (apps/server)
# ─────────────────────────────────────────────────────────────

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor HTTP + WebSocket
PORT=4000

# Origen permitido para CORS y socket.io (URL del frontend Vite)
CORS_ORIGIN=http://localhost:5173

# ── Base de datos ────────────────────────────────────────────
# Local (Docker/Postgres):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestor
# Producción (Neon - Postgres serverless), ejemplo:
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxx.neon.tech/gestor?sslmode=require

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (autenticación de agentes) ───────────────────────────
# Generá secretos largos y aleatorios (>=32 chars). NO los compartas.
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-acceso
JWT_REFRESH_SECRET=cambia-esto-por-un-secreto-largo-de-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── OpenWA Gateway (servicio self-hosted aparte, ver docker-compose.yml) ─────
# NO es el paquete npm "@open-wa/wa-automate" (deprecado); es un proyecto
# distinto y activamente mantenido con el mismo nombre: github.com/rmyndharis/OpenWA
OPENWA_GATEWAY_URL=http://localhost:2785
OPENWA_GATEWAY_API_KEY=owa_k1_bbf0aa973b252c55638205ff44bfc73b2c637239d18fd19babb79c0bf8d2dd01
OPENWA_GATEWAY_SESSION_NAME=gestor-campanas
# El contenedor de OpenWA llama a esta URL para entregar eventos (webhooks).
# host.docker.internal permite que el contenedor alcance el server en el host.
OPENWA_GATEWAY_WEBHOOK_URL=http://host.docker.internal:4000/webhooks/openwa
OPENWA_GATEWAY_WEBHOOK_SECRET=53d318ef06bd779337a51063ddb4ce372752d82e9f241101

# ── Limitador de tasa dinámico (BullMQ) ──────────────────────
# Máximo de mensajes por ventana y duración de la ventana en ms.
# Ej: 10 mensajes cada 300000 ms (5 min). Editable en caliente vía pub/sub.
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MS=300000

# ── Organización por defecto (single-tenant en Fase 1) ───────
DEFAULT_ORG_SLUG=default
