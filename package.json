{
  "name": "gestor-de-campanas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @gestor/server",
    "dev:web": "npm run dev -w @gestor/web",
    "build": "npm run build -w @gestor/core && npm run build -w @gestor/server && npm run build -w @gestor/web",
    "build:core": "npm run build -w @gestor/core",
    "db:push": "npm run db:push -w @gestor/server",
    "db:generate": "npm run db:generate -w @gestor/server",
    "db:studio": "npm run db:studio -w @gestor/server",
    "db:seed": "npm run db:seed -w @gestor/server",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
