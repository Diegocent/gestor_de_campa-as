# PostgreSQL (local Docker)
DATABASE_URL=postgresql://campanas:campanas_secret@localhost:3069/gestor_campanas

# Redis (local Docker) - cola BullMQ
REDIS_URL=redis://localhost:6379

# Organización por defecto (marca blanca)
DEFAULT_ORG_SLUG=default

# OpenWA — modo gateway (recomendado) o embedded
# Ver docs/OPENWA.md
OPENWA_MODE=gateway
OPENWA_GATEWAY_URL=http://localhost:2785
OPENWA_API_KEY=your-api-key-from-dashboard
OPENWA_SESSION_ID=gestor-campanas

# Solo modo embedded (@open-wa/wa-automate en el mismo proceso)
OPENWA_HEADLESS=true
OPENWA_MULTI_DEVICE=true

# Rate limiting (10 mensajes / 5 minutos). También editable desde la UI.
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MINUTES=5
RATE_LIMIT_DURATION_MS=300000
