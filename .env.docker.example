# Variables para Docker Compose (copiar a .env)
# cp .env.docker.example .env

# OpenWA genera la clave al primer arranque. Obtenerla con:
#   docker compose logs openwa-api | findstr owa_k1
OPENWA_API_KEY=owa_k1_REEMPLAZAR_CON_LA_DE_TUS_LOGS

OPENWA_SESSION_ID=gestor-campanas
VITE_API_URL=http://localhost:2785

# Ritmo de envío (valores por defecto si aún no se configuró en la UI)
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MINUTES=5
